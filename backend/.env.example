# Copy this file to .env. Never commit the real .env file.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5433/careerpath
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_DAYS=14
# Development only: show records waiting for review, labelled as such
SHOW_UNPUBLISHED=true
# Optional, this computer only: lets Gemini reword assistant answers. The assistant works without it,
# and it always stays off in production. Read docs/ARCHITECTURE.md section 7 first.
ASSISTANT_AI=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Account emails (password reset codes). Leave SMTP_HOST empty for laptop mode: emails are printed
# in the server window and saved to laptop-emails.log instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
